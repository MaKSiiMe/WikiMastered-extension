{
  "manifest_version": 3,
  "name": "WikiMastered – Prix des cartes",
  "version": "0.8.1",
  "description": "Wiki Masters : prix moyen des cartes, bilan des échanges et automatisation par clic optionnelle.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.wiki-masters.com/*",
    "https://wiki-masters.com/*"
  ],
  "optional_host_permissions": [
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/background.js"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "WikiMastered : ouvrir le panneau (Alt+Maj+W)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "src/panel.html"
  },
  "sidebar_action": {
    "default_panel": "src/panel.html",
    "default_title": "WikiMastered",
    "default_icon": "icons/icon-32.png",
    "open_at_install": false
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Ouvrir le panneau WikiMastered"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.wiki-masters.com/*",
        "https://wiki-masters.com/*"
      ],
      "js": [
        "src/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.wiki-masters.com/*",
        "https://wiki-masters.com/*"
      ],
      "js": [
        "src/lib.js",
        "src/click.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "wikimastered-extension@maksiime",
      "strict_min_version": "128.0"
    }
  }
}
