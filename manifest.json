{
  "manifest_version": 3,
  "name": "WikiMastered – Prix des cartes",
  "version": "0.2.2",
  "description": "Wiki Masters en lecture seule : le prix moyen de chaque carte affiché sur la page, le même que sur sa fiche.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.wiki-masters.com/*", "https://wiki-masters.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.wiki-masters.com/*", "https://wiki-masters.com/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.wiki-masters.com/*", "https://wiki-masters.com/*"],
      "js": ["src/lib.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "wikimastered-extension@maksiime", "strict_min_version": "128.0" }
  }
}
